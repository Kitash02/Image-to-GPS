# ============================================================================
# DATA & IMAGES (DO NOT COMMIT)
# ============================================================================
# Images are user-provided and should not be versioned
data/dataset_root/images/
data/dataset_root/*.jpg
data/dataset_root/*.jpeg
data/dataset_root/*.png
data/dataset_root/*.HEIC
data/dataset_root/*.heic

# Generated master dataset (can regenerate from EXIF)
data/dataset_root/campus_gps_master_dataset.csv

# ============================================================================
# TRAINED MODELS & ARTIFACTS (LARGE FILES)
# ============================================================================
# Model weights are large; use Git LFS if versioning is needed
models/**/*.pth
models/**/*.pt
models/**/best_model.pth

# Scalers and checkpoints
models/**/*.pkl
models/**/*.pickle

# Training artifacts
models/**/scaler.pkl
models/**/checkpoint*.pth

